{
  "name": "personal-assistant",
  "type": "module",
  "scripts": {
    "dev": "INNGEST_DEV=1 tsx watch --env-file=.env --import ./src/instrument.ts src/index.ts",
    "build": "tsc",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "set-webhook": "tsx --env-file=.env scripts/set-webhook.ts",
    "postinstall": "patch-package",
    "daytona-hello": "tsx --env-file=.env scripts/daytona-hello.ts",
    "db:studio": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs studio",
    "db:push": "tsx --env-file=.env node_modules/drizzle-kit/bin.cjs push"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@daytona/sdk": "^0.232.0",
    "@hono/node-server": "^2.1.3",
    "@inngest/agent-kit": "^0.13.2",
    "@inngest/middleware-sentry": "^1.0.0",
    "@linqapp/sdk": "0.86.1",
    "@mendable/firecrawl-js": "^4.54.0",
    "@neon/config": "^1.14.0",
    "@neon/env": "^2.1.3",
    "@sentry/hono": "^11.16.0",
    "@sentry/node": "^11.16.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "inngest": "^4.26.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hono/cli": "^1.0.0-rc.9",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2"
  }
}
